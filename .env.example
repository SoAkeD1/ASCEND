# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# --- Required ---
# Random string, at least 32 characters. Signs the session cookie.
SESSION_SECRET=
# Random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/daily.
CRON_SECRET=

# --- Database ---
# Leave empty locally to use PGlite (Postgres in WebAssembly, files in PGLITE_DIR).
# Production: the Supabase connection string (Project Settings → Database → Connection pooling, port 6543).
DATABASE_URL=
PGLITE_DIR=.pglite

# --- Roles ---
# Comma-separated emails that become admin / lender when they sign in.
ADMIN_EMAILS=
LENDER_EMAILS=

# --- Demo mode ---
# "true" shows admin demo tools (create test user, time travel, force AutoPay failure, inject DPD, reset).
DEMO_MODE=false

# --- Sign-in codes ---
# email (default) or sms
AUTH_CHANNEL=email
# sandbox (code shown on screen, labelled), resend (email) or twilio (sms)
OTP_PROVIDER=sandbox
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Misc ---
APP_TIMEZONE=Asia/Kolkata
# Public URL used in share links (Family View, WhatsApp, QR codes). Optional; falls back to the request host.
APP_URL=
